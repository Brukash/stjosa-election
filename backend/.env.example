# ── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL (Project Settings -> Database -> Connection string)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development fallback (used when DATABASE_URL is not set):
DATABASE_URL=sqlite:///./election.db

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="St. John's College Jos Alumni Election Management System"
# development | production (non-development disables dev-only behaviour)
ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000

# ── Secrets (CHANGE THESE BEFORE ANY REAL ELECTION) ──────────────────────────
SECRET_KEY=dev-only-change-me-please-32-bytes-minimum
MASTER_KEY=dev-only-master-key-change-me-32-bytes-minimum
OTP_HASH_PEPPER=dev-only-otp-pepper-change-me

# ── OTP delivery ─────────────────────────────────────────────────────────────
# On-screen OTP is only honoured when ENVIRONMENT=development AND APP_ORIGIN is
# loopback. It can never be enabled in production by this flag alone.
DEV_EXPOSE_OTP=true

# Simultaneous delivery: configure every channel that should receive the same OTP.
# Email provider: resend | smtp | none
EMAIL_PROVIDER=none
EMAIL_FROM="SJC Jos Alumni Election <no-reply@elections.sjcjos-alumni.org>"

# Resend (https://resend.com) — set EMAIL_PROVIDER=resend
RESEND_API_KEY=
# EMAIL_API_BASE=https://api.resend.com

# SMTP fallback — set EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# SMS through Termii — set SMS_PROVIDER=termii
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd
# TERMII_API_BASE=https://api.ng.termii.com

# Legacy SMS fallback only. Termii is the supported provider for OTPs.
# SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SMS_API_BASE=https://api.twilio.com

# WhatsApp through the official Meta WhatsApp Business Platform / Cloud API.
WHATSAPP_PROVIDER=none
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=sjc_election_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_REGISTRATION_TEMPLATE_NAME=sjc_registration_confirmation
WHATSAPP_REGISTRATION_TEMPLATE_LANGUAGE=en_US
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_BASE=https://graph.facebook.com/v27.0

OTP_DELIVERY_TIMEOUT_SECONDS=10

# ── Operational settings ─────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=10
ACCESS_TOKEN_TTL_MINUTES=480
SEED_DEFAULT_PASSWORD=ChangeMe!2026
KEYS_DIR=./keys
